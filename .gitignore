.venv/
artifacts/
__pycache__/
*.pyc
data/*.jsonl
data/*.csv
data/diff_cache/

# 61G: the restored CVEfixes dump plus the .sql.gz it came from
data/cvefixes/
# 131M of partial clones, re-fetchable by corpus/mine.py
data/repos/
# generated knowledge graph and its AST cache
graphify-out/
# sft.log, dpo.log, detect.log, cve.log
*.log

# agent / IDE tooling config, machine-local
.claude/
.clinerules/
.cursor/
.opencode/
.windsurf/
.cline/

# packaging (pip install -e .)
*.egg-info/
# 38M of published baseline data, re-fetchable (see corpus/deepjit.py)
data/deepjit/

# Results, not bulk data — these are small and must survive a fresh clone.
# `data/*.jsonl` and `data/*.csv` above would otherwise swallow them.
!data/real_commits.jsonl
!data/handgrade_mechanism_v1.csv
# Benchmark run files: small, and every table in RESULTS.md is scored from them
# (`basic_bench.py --score`). `data/*.jsonl` above would otherwise swallow them.
!data/basic_bench_*.jsonl
!data/heldout_mech_v2*.jsonl
!data/heldout_clean_v2*.jsonl
# The `v2` patterns above predate v3/v4/v6 and were never widened, so every
# held-out run since was silently ignored while the basic_bench runs beside it
# were kept. Same rationale, same sizes (28-132K), and RESULTS.md quotes numbers
# from all of them.
!data/heldout_mech_*.jsonl
!data/heldout_clean_*.jsonl
!data/real_commits_v6*.jsonl
# The SFT corpora (1.6M each). A checkpoint is only auditable against the corpus
# it actually saw - that is why sft_v4_suggest.jsonl is kept after v6 replaced
# it - so these have to survive a fresh clone alongside the runs that used them.
!data/sft_v4_suggest.jsonl
!data/sft_v6_suggest.jsonl

# 11M of BugsInPy metadata plus the project clones and per-bug worktrees it
# drives. Re-fetchable by bench/bugsinpy.py --fetch.
data/bugsinpy/
